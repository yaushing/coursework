                                                 (H+prp de)
                                                 (P<+n consumo))
                                               (CO+conj-c e)
                                               (CJT+pp 
                                                 (H+prp de)
                                                 (P<+n investimento)))))
                                         (,)
                                         (N<PRED+pp 
