                       (,)
                       (CO+conj-c mas)
                       (CJT+fcl (SUB+conj-s que)
                                (SUBJ+adv tal)
                                (P+vp (AUX+v-fin virá)
                                      (PRT-AUX<+prp a)
                                      (MV+v-inf acontecer))
