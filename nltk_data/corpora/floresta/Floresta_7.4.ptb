                                           (H+n ourivesaria))
                                         (CO+conj-c e)
                                         (CJT+n joalharia)))))))
           (.))
  
#2609 CP496-5 A exposição -- formada sobretudo por objectos provenientes de colecções particulares -- inicia-se cronologicamente no século XVII e vem até aos nossos dias.
(STA+fcl (SUBJ+np (>N+art A)
                    (H+n exposição)
                    (--)
                    (N<PRED+icl (P+v-pcp formada)
                                (PASS+pp 
                                  (>A+adv sobretudo)
                                  (H+prp por)
                                  (P<+np 
                                    (H+n objectos)
                                    (N<+ap 
                                      (H+adj provenientes)
                                      (A<+pp 
                                        (H+prp de)
                                        (P<+np 
                                          (H+n colecções)
                                          (N<+adj particulares)))))))
                    (--))
           (?+cu (CJT+? (P+v-fin inicia-)
                        (ACC+pron-pers se)
                        (ADVL+adv cronologicamente)
                        (ADVS+pp (H+prp em)
                                 (P<+np (>N+art o)
                                        (H+n século)
                                        (N<+adj XVII))))
                 (CO+conj-c e)
                 (CJT+? (P+v-fin vem)
                        (ADVS+pp (H+prp até)
                                 (P<+pp (H+prp a)
                                        (P<+np 
                                          (>N+art os)
                                          (>N+pron-det nossos)
                                          (H+n dias))))))
           (.))
  
#2610 CP496-6 Entre as jóias apresentadas contam-se colares de brilhantes e esmeraldas (séc. XVIII e XIX), peças de ouro popular, trenedeiras, crisólitas, laças, condecorações das ordens de Malta e de Cristo em minas e brilhantes e uma caixa de rapé do Rei Carlos Alberto.
(STA+fcl (ADVL+pp (H+prp Entre)
                    (P<+np (>N+art as)
                           (H+n jóias)
                           (N<+v-pcp apresentadas)))
           (P+v-fin contam-)
           (ACC+pron-pers se)
           (SUBJ+cu (CJT+np (H+n colares)
                            (N<+pp (H+prp de)
                                   (P<+cu 
                                     (CJT+n brilhantes)
                                     (CO+conj-c e)
                                     (CJT+n esmeraldas)))
                            ({)
                            (N<PRED+np (H+n séc.)
                                       (N<+cu 
                                         (CJT+adj XVIII)
                                         (CO+conj-c e)
                                         (CJT+adj XIX)))
                            (}))
                    (,)
                    (CJT+np (H+n peças)
                            (N<+pp (H+prp de)
                                   (P<+np 
                                     (H+n ouro)
                                     (N<+adj popular))))
                    (,)
                    (CJT+n trenedeiras)
                    (,)
                    (CJT+n crisólitas)
                    (,)
                    (CJT+n laças)
                    (,)
                    (CJT+np (H+n condecorações)
                            (N<+pp (H+prp de)
                                   (P<+np 
                                     (>N+art as)
                                     (H+n ordens)
                                     (N<+cu 
                                       (CJT+pp 
                                         (H+prp de)
                                         (P<+prop Malta))
                                       (CO+conj-c e)
                                       (CJT+pp 
                                         (H+prp de)
                                         (P<+prop Cristo)))))
                            (N<+pp (H+prp em)
                                   (P<+cu 
                                     (CJT+n minas)
                                     (CO+conj-c e)
                                     (CJT+n brilhantes))))
                    (CO+conj-c e)
                    (CJT+np (>N+art uma)
                            (H+n caixa)
                            (N<+pp (H+prp de)
                                   (P<+n rapé))
                            (N<+pp (H+prp de)
                                   (P<+np 
                                     (>N+art o)
                                     (H+prop Rei_Carlos_Alberto)))))
           (.))
  
