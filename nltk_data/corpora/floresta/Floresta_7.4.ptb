                                     (CJT+prop Manuel_Adélio_Valle_Gomes))))
           (,)
           (SUBJ+np (>N+art o)
                    (H+n certame))
           (P+v-fin conta)
           (PIV+pp (H+prp com)
                   (P<+np (>N+art o)
                          («)
                          (>N+adj alto)
                          (H+n patrocínio)
                          (»)
                          (N<+pp (H+prp de)
                                 (P<+np (>N+art os)
                                        (H+n duques)
                                        (N<+pp 
                                          (H+prp de)
                                          (P<+prop Bragança))
                                        (,)
                                        (N<PRED+fcl 
                                          (SUBJ+pron-indp que)
                                          (P+v-fin cederam)
                                          (ADVL+pp 
                                            (H+prp para)
                                            (P<+np 
                                              (>N+art a)
                                              (H+n ocasião)))
                                          (ACC+np 
                                            (>N+art a)
                                            (H+n tiara)
                                            (N<+pp 
                                              (H+prp em)
                                              (P<+n brilhantes))
                                            (N<+pp 
                                              (H+prp de)
                                              (P<+np 
                                                (>N+art o)
                                                (H+n século)
                                                (N<+adj XIX)))
                                            (N<+icl 
                                              (P+v-pcp usada)
                                              (PASS+pp 
                                                (H+prp por)
                                                (P<+prop Isabel_Herédia))
                                              (ADVL+pp 
                                                (H+prp em)
                                                (P<+np 
                                                  (>N+art o)
                                                  (H+n casamento)
                                                  (N<+pp 
                                                    (H+prp com)
                                                    (P<+prop Duarte_Pio)))))))))))
           (.))
  
#2608 CP496-4 Segundo Virgílio Folhadela, presidente da Associação Comercial do Porto, entidade que promove a iniciativa, a mostra tem como um dos seus objectivos principais revelar a forte tradição nortenha nos campos da ourivesaria e joalharia.
(STA+fcl (ADVL+pp (H+prp Segundo)
