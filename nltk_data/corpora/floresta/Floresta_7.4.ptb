           (ADVL+adv anteontem)
           (-P+vp (MV+v-pcp empossado))
           (SUBJ+np (>N+art o)
                    (H+n grupo)
                    (N<+pp (H+prp de)
                           (P<+np (H+n trabalho)
                                  (N<+adj interministerial)))
                    (N<+fcl (SUBJ+pron-indp que)
                            (P+vp (AUX+v-fin vai)
                                  (MV+v-inf preparar))
                            (ACC+np (>N+art a)
                                    (H+n articulação)
                                    (N<+pp 
                                      (H+prp entre)
                                      (P<+cu 
                                        (CJT+np 
                                          (>N+art as)
                                          (H+n bibliotecas)
                                          (N<+adj escolares))
                                        (CO+conj-c e)
                                        (CJT+np 
                                          (H+pron-det as)
                                          (N<+pp 
                                            (H+prp de)
                                            (P<+np 
                                              (>N+art a)
                                              (H+n rede)
                                              (N<+pp 
                                                (H+prp de)
                                                (P<+np 
                                                  (H+n leitura)
                                                  (N<+adj pública)))))))))))
           (.))
  
