                                         (H+n suspensão))
                                       (CO+conj-c ou)
                                       (CJT+n demissão))
                                     (N<+cu 
                                       (CJT+pp 
                                         (H+prp de)
                                         (P<+np 
                                           (>N+art o)
                                           (H+n médico)
                                           (N<+n veterinário)
                                           (N<+adj coordenador)))
                                       (CO+conj-c ou)
                                       (CJT+pp 
                                         (H+prp de)
                                         (P<+np 
                                           (>N+art os)
                                           (H+n executores)))))))
                    (ADVL+pp (H+prp no_decurso_de)
                             (P<+np (>N+art o)
                                    (H+n programa)
                                    (N<+adj sanitário)
                                    (N<+adj anual)))
                    (,)
                    (ADVL+pp (H+prp a)
                             (P<+icl (ADVL+adv não)
                                     (P+v-inf ser)
                                     (SC+pp 
                                       (H+prp por)
                                       (P<+np 
                                         (H+n motivo)
                                         (N<+pp 
                                           (H+prp de)
                                           (P<+n força_maior))
                                         (,)
                                         (N<PRED+icl 
                                           (ADVL+adv devidamente)
                                           (P+cu 
                                             (CJT+v-pcp justificado)
                                             (CO+conj-c e)
                                             (CO+v-pcp aceite))
                                           (PASS+pp 
                                             (H+prp por)
                                             (P<+np 
                                               (>N+art a)
                                               (H+n direcção)
                                               (N<+adj regional)
                                               (N<+pp 
                                                 (H+prp de)
                                                 (P<+n agricultura)))))
                                         (,)
                                         (N<PRED+pp 
                                           (H+prp com)
                                           (P<+np 
                                             (>N+adj posterior)
                                             (H+n homologação)
                                             (N<+pp 
                                               (H+prp por)
                                               (P<+np 
                                                 (>N+art a)
                                                 (H+prop Direcção_Geral_de_Veterinária)))))))))
                    (»))
