#2606 CP496-2 «Reais jóias do Norte de Portugal» é o título de uma exposição que irá decorrer entre os próximos dias 10 e 26 de Novembro no Palácio da Bolsa, no Porto.
(STA+fcl («)
           (SUBJ+prop Reais_jóias_do_Norte_de_Portugal)
           (»)
           (P+v-fin é)
           (SC+np (>N+art o)
                  (H+n título)
                  (N<+pp (H+prp de)
                         (P<+np (>N+art uma)
                                (H+n exposição)
                                (N<+fcl (SUBJ+pron-indp que)
                                        (P+vp 
                                          (AUX+v-fin irá)
                                          (MV+v-inf decorrer))
                                        (ADVL+pp 
                                          (H+prp entre)
                                          (P<+np 
                                            (>N+art os)
                                            (>N+adj próximos)
                                            (H+n dias)
                                            (N<+cu 
                                              (CJT+num 10)
                                              (CO+conj-c e)
                                              (CJT+num 26))
                                            (N<+pp 
                                              (H+prp de)
                                              (P<+n Novembro))))
                                        (ADVL+pp 
                                          (H+prp em)
                                          (P<+np 
                                            (>N+art o)
                                            (H+prop Palácio_da_Bolsa)
                                            (,)
                                            (N<PRED+pp 
                                              (H+prp em)
                                              (P<+np 
                                                (>N+art o)
                                                (H+prop Porto)))))))))
           (.))
  
#2607 CP496-3 Comissariado conjuntamente por Jú Távora e Manuel Adélio Valle Gomes, o certame conta com o «alto patrocínio» dos duques de Bragança, que cederam para a ocasião a tiara em brilhantes do século XIX usada por Isabel Herédia no casamento com Duarte Pio.
(STA+fcl (PRED+icl (P+v-pcp Comissariado)
                     (ADVL+adv conjuntamente)
                     (PASS+pp (H+prp por)
                              (P<+cu (CJT+prop Jú_Távora)
