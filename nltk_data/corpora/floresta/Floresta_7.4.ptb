                                    (H+prp de)
                                    (P<+np 
                                      (>N+art os)
                                      (H+n apoios)
                                      (N<+adj financeiros))))
                         (ADVL+adv já)
                         (P+v-fin estará)
                         (SC+v-pcp garantida))
               (.))
      
