                                         (N<+adj deliciosos)))
                                     (CO+conj-c e)
                                     (CJT+fcl 
                                       (SUB+conj-s que)
                                       (SUBJ+np 
                                         (>N+art a)
                                         (H+n patrulha)
                                         (N<+pp 
                                           (H+prp de)
                                           (P<+np 
                                             (>N+art o)
                                             (H+n colesterol))))
                                       (P+vp 
                                         (AUX+v-fin deve)
                                         (MV+v-inf dar))
