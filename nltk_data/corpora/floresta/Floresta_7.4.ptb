                                                (H+n revista))))
                                          (PIV+pp 
                                            (H+prp a)
                                            (P<+cu 
                                              (CJT+np 
                                                (H+pron-pers eles)
                                                (N<+pron-det próprios))
                                              (,)
                                              (CJT+prop Christo)
                                              (CO+conj-c e)
                                              (CJT+prop Voss)))))
                                 (CO+conj-c e)
                                 (CJT+? (P+v-fin acordaram)
                                        (ADVL+pp 
                                          (H+prp em)
                                          (P<+fcl 
                                            (SUB+conj-s que)
                                            (SUBJ+np 
                                              (>N+pron-det cada)
