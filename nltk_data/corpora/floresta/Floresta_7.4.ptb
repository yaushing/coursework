                                     (,)
                                     (ADVL+icl 
                                       (P+v-ger tornando)
                                       (OC+adj impossível)
                                       (ADVL+pp 
                                         (H+prp por)
                                         (P<+np 
                                           (>N+art a)
                                           (H+n competição)))
