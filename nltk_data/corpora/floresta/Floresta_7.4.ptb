                                                  (H+prp para)
                                                  (P<+np 
                                                    (>N+art a)
                                                    (>N+adj nova)
                                                    (H+n época))))))
                                          (;)
                                          (APP+np 
                                            (>N+art a)
                                            (H+n fixação)
                                            (N<+pp 
                                              (H+prp de)
