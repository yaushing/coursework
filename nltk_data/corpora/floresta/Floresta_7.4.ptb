                                           (PASS+pp 
                                             (H+prp por)
                                             (P<+np 
                                               (>N+art o)
                                               (H+n socialista)
                                               (N<+prop Rosado_Correia))))
                                         (,))))
                                   (P+v-fin assinou)
                                   (ADVL+pp 
                                     (H+prp com)
                                     (P<+np 
                                       (>N+art a)
                                       (H+prop Câmara_de_Fafe)))
                                   (ACC+np 
                                     (>N+art um)
                                     (H+n protocolo)
                                     (N<+fcl 
                                       (ADVL+pp 
                                         (H+prp em)
                                         (P<+pron-indp o_qual))
                                       (ACC+pron-pers se)
                                       (P+v-fin comprometia)
                                       (PIV+np 
                                         (H+cu 
                                           (CJT+pp 
                                             (H+prp a)
                                             (P<+icl 
                                               (P+v-inf custear)
                                               (ACC+np 
                                                 (>N+art um)
                                                 (H+n centro)
                                                 (N<+ap 
                                                   (H+adj coordenador)
                                                   (A<+pp 
                                                     (H+prp de)
                                                     (P<+n transportes))))
                                               (ADVL+pp 
                                                 (H+prp até)
                                                 (P<+pp 
                                                   (H+prp a)
                                                   (P<+np 
                                                     (>N+art o)
                                                     (H+n montante)
                                                     (N<+pp 
                                                       (H+prp de)
                                                       (P<+np 
                                                         (>N+ap 
                                                           (>A+num cem)
                                                           (H+num mil))
                                                         (H+n contos))))))))
                                           (CO+conj-c e)
                                           (CJT+pp 
                                             (H+prp a)
                                             (P<+icl 
                                               (P+v-inf financiar)
                                               (ADVL+pp 
                                                 (H+prp em)
                                                 (P<+np 
                                                   (>N+num 90)
                                                   (H+n por_cento)))
                                               (ACC+np 
                                                 (>N+art a)
                                                 (H+n construção)
                                                 (N<+pp 
                                                   (H+prp de)
                                                   (P<+np 
                                                     (>N+art uma)
                                                     (H+n via)
                                                     (N<+adj circular)
                                                     (N<+pp 
                                                       (H+prp a)
                                                       (P<+np 
                                                         (>N+art a)
                                                         (H+n cidade)))))))))
                                         (,)
                                         (N<PRED+acl 
                                           (PRD+adv como)
                                           (SC+np 
                                             (H+n contrapartidas)
                                             (N<+pp 
                                               (H+prp a)
                                               (P<+np 
                                                 (>N+art a)
                                                 (H+n desactivação)
                                                 (N<+pp 
                                                   (H+prp de)
                                                   (P<+np 
                                                     (>N+art a)
                                                     (H+n linha)
                                                     (N<+adj férrea)
                                                     (N<+pp 
                                                       (H+prp entre)
                                                       (P<+cu 
                                                         (CJT+prop Guimarães)
