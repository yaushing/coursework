#849 CP161-1 O rio Grande nasce no concelho de Torres Vedras e atravessa todo o concelho da Lourinhã sendo as suas águas consideradas excessivamente poluídas e impróprias para qualquer uso, segundo dados de 1987 da Direcção Geral da Qualidade do Ambiente.
(STA+fcl (SUBJ+np (>N+art O)
                        (H+np (H+n rio)
                              (N<+prop Grande)))
               (?+cu (CJT+? (P+v-fin nasce)
                            (ADVL+pp (H+prp em)
                                     (P<+np 
                                       (>N+art o)
                                       (H+n concelho)
                                       (N<+pp 
                                         (H+prp de)
                                         (P<+prop Torres_Vedras)))))
                     (CO+conj-c e)
                     (CJT+? (P+v-fin atravessa)
                            (ACC+np (>N+pron-det todo_o)
                                    (H+n concelho)
                                    (N<+pp 
                                      (H+prp de)
                                      (P<+np 
                                        (>N+art a)
                                        (H+prop Lourinhã))))))
               (ADVL+icl (P+vp- (AUX+v-ger sendo))
                         (SUBJ+np (>N+art as)
                                  (>N+pron-det suas)
                                  (H+n águas))
                         (-P+vp (MV+v-pcp consideradas))
                         (SC+cu (CJT+ap (>A+adv excessivamente)
                                        (H+v-pcp poluídas))
                                (CO+conj-c e)
                                (CJT+ap (H+adj impróprias)
                                        (A<+pp 
                                          (H+prp para)
                                          (P<+np 
                                            (>N+pron-det qualquer)
                                            (H+n uso)))))
                         (,)
                         (ADVL+pp (H+prp segundo)
                                  (P<+np 
                                    (H+n dados)
                                    (N<+pp 
                                      (H+prp de)
                                      (P<+num 1987))
                                    (N<+pp 
                                      (H+prp de)
                                      (P<+np 
                                        (>N+art a)
                                        (H+prop Direcção_Geral_da_Qualidade_do_Ambiente))))))
               (.))
      
#850 CP161-2 Neste estudo são apontados como principais fontes poluidores as pecuárias, matadouros e esgotos domésticos sendo observados vários casos de contaminação de águas de fontanários e poços.
(STA+fcl (ADVL+pp (H+prp Em)
                        (P<+np (>N+pron-det este)
                               (H+n estudo)))
               (P+vp (AUX+v-fin são)
                     (MV+v-pcp apontados))
               (SC+acl (PRD+adv como)
                       (SC+np (>N+adj principais)
                              (H+n fontes)
                              (N<+adj poluidores)))
               (SUBJ+cu (CJT+np (>N+art as)
                                (H+n pecuárias))
                        (,)
                        (CJT+n matadouros)
                        (CO+conj-c e)
                        (CJT+np (H+n esgotos)
                                (N<+adj domésticos)))
               (ADVL+icl (P+vp (AUX+v-ger sendo)
                               (MV+v-pcp observados))
                         (SUBJ+np (>N+pron-det vários)
                                  (H+n casos)
                                  (N<+pp 
                                    (H+prp de)
                                    (P<+np 
                                      (H+n contaminação)
                                      (N<+pp 
                                        (H+prp de)
                                        (P<+np 
                                          (H+n águas)
                                          (N<+pp 
                                            (H+prp de)
                                            (P<+cu 
                                              (CJT+n fontanários)
                                              (CO+conj-c e)
                                              (CJT+n poços)))))))))
               (.))
      
#851 CP161-3 À sua poluição deve-se ainda o desaparecimento dos famosos bivalves negros da «Mexelhoeira», uma zona de rochas entre as praias da Areia Branca e do Peralta.
(STA+fcl (PIV+pp (H+prp A)
                       (P<+np (>N+art a)
                              (>N+pron-det sua)
                              (H+n poluição)))
               (P+v-fin deve-)
               (ACC+pron-pers se)
               (ADVL+adv ainda)
               (SUBJ+np (>N+art o)
                        (H+n desaparecimento)
                        (N<+pp (H+prp de)
                               (P<+np (>N+art os)
                                      (>N+adj famosos)
                                      (H+n bivalves)
                                      (N<+adj negros)
                                      (N<+pp 
                                        (H+prp de)
                                        (P<+np 
                                          (>N+art a)
                                          («)
                                          (H+prop Mexelhoeira)
                                          (»)
                                          (,)
                                          (N<PRED+np 
                                            (>N+art uma)
                                            (H+n zona)
                                            (N<+pp 
                                              (H+prp de)
                                              (P<+n rochas))
                                            (N<+pp 
                                              (H+prp entre)
                                              (P<+np 
                                                (>N+art as)
                                                (H+n praias)
                                                (N<+cu 
                                                  (CJT+pp 
                                                    (H+prp de)
                                                    (P<+np 
                                                      (>N+art a)
                                                      (H+prop Areia_Branca)))
                                                  (CO+conj-c e)
                                                  (CJT+pp 
                                                    (H+prp de)
                                                    (P<+np 
                                                      (>N+art o)
                                                      (H+prop Peralta))))))))))))
               (.))
      
#852 CP161-4 As histórias da poluição do rio Grande correm toda a região, desde o aparecimento de cadáveres de animais na sua foz até ao boato de um surto de hepatite B que no ano passado afastou centenas de veraneantes.
(STA+fcl (SUBJ+np- (>N+art As)
                         (H+n histórias)
                         (N<+pp (H+prp de)
                                (P<+np (>N+art a)
                                       (H+n poluição)
                                       (N<+pp 
                                         (H+prp de)
                                         (P<+np 
                                           (>N+art o)
                                           (H+np 
                                             (H+n rio)
                                             (N<+prop Grande)))))))
               (P+v-fin correm)
               (ADVS+np (>N+pron-det toda_a)
                        (H+n região))
               (,)
               (-SUBJ+np (N<+cu (PCJT+pp 
                                  (H+prp desde)
                                  (P<+np 
                                    (>N+art o)
                                    (H+n aparecimento)
                                    (N<+pp 
                                      (H+prp de)
                                      (P<+np 
                                        (H+n cadáveres)
                                        (N<+pp 
                                          (H+prp de)
                                          (P<+n animais))))
                                    (N<+pp 
                                      (H+prp em)
                                      (P<+np 
                                        (>N+art a)
                                        (>N+pron-det sua)
                                        (H+n foz)))))
                                (PCJT+pp 
                                  (H+prp até)
                                  (P<+pp 
                                    (H+prp a)
                                    (P<+np 
                                      (>N+art o)
                                      (H+n boato)
                                      (N<+pp 
                                        (H+prp de)
                                        (P<+np 
                                          (>N+art um)
                                          (H+n surto)
                                          (N<+pp 
                                            (H+prp de)
                                            (P<+np 
                                              (H+n hepatite_B)
                                              (N<+fcl 
                                                (SUBJ+pron-indp que)
                                                (ADVL+pp 
                                                  (H+prp em)
                                                  (P<+np 
                                                    (>N+art o)
                                                    (H+n ano)
                                                    (N<+v-pcp passado)))
                                                (P+v-fin afastou)
                                                (ACC+np 
                                                  (H+n centenas)
                                                  (N<+pp 
                                                    (H+prp de)
                                                    (P<+n veraneantes)))))))))))))
               (.))
      
#853 CP161-5 Na perspectiva da autarquia este quadro está em vias de melhorar pois existem já projectos para cinco estações de tratamento domésticos das principais localidades do concelho e duas centrais de tratamento de dejectos das suiniculturas para posterior transformação em fertilizante, já candidatas a fundos comunitários, isto para além das várias pequenas estações de tratamento que estão previstas em todo o concelho.
(STA+fcl (ADVL+pp (H+prp Em)
                        (P<+np (>N+art a)
                               (H+n perspectiva)
                               (N<+pp (H+prp de)
                                      (P<+np 
                                        (>N+art a)
                                        (H+n autarquia)))))
               (SUBJ+np (>N+pron-det este)
                        (H+n quadro))
               (P+v-fin está)
               (SC+pp (H+prp em_vias_de)
                      (P<+v-inf melhorar))
               (ADVL+fcl (ADVL+adv pois)
                         (P+v-fin existem)
                         (ADVL+adv já)
                         (SUBJ+np (H+n projectos)
                                  (N<+pp 
                                    (H+prp para)
                                    (P<+np 
                                      (H+cu 
                                        (CJT+np 
                                          (>N+num cinco)
                                          (H+n estações)
                                          (N<+pp 
                                            (H+prp de)
                                            (P<+np 
                                              (H+n tratamento)
                                              (N<+adj domésticos)
                                              (N<+pp 
                                                (H+prp de)
                                                (P<+np 
                                                  (>N+art as)
                                                  (>N+adj principais)
                                                  (H+n localidades)
                                                  (N<+pp 
                                                    (H+prp de)
                                                    (P<+np 
                                                      (>N+art o)
                                                      (H+n concelho))))))))
                                        (CO+conj-c e)
                                        (CJT+np 
                                          (>N+num duas)
                                          (H+n centrais)
                                          (N<+pp 
                                            (H+prp de)
                                            (N<+np 
                                              (H+n tratamento)
                                              (N<+pp 
                                                (H+prp de)
                                                (P<+np 
                                                  (H+n dejectos)
                                                  (N<+pp 
                                                    (H+prp de)
                                                    (P<+np 
                                                      (>N+art as)
                                                      (H+n suiniculturas)))))
                                              (N<+pp 
                                                (H+prp para)
                                                (P<+np 
                                                  (>N+adj posterior)
                                                  (H+n transformação)
                                                  (N<+pp 
                                                    (H+prp em)
                                                    (P<+n fertilizante))))))))
                                      (,)
                                      (N<PRED+icl 
                                        (ADVL+adv já)
                                        (P+v-pcp candidatas)
                                        (PIV+pp 
                                          (H+prp a)
                                          (P<+np 
                                            (H+n fundos)
                                            (N<+adj comunitários))))
                                      (,)
                                      (N<PRED+np 
                                        (H+pron-indp isto)
                                        (N<+pp 
                                          (H+pp para_além)
                                          (P<+pp 
                                            (H+prp de)
                                            (P<+np 
                                              (>N+art as)
                                              (>N+pron-det várias)
                                              (>N+adj pequenas)
                                              (H+n estações)
                                              (N<+pp 
                                                (H+prp de)
                                                (P<+n tratamento))
                                              (N<+fcl 
                                                (SUBJ+pron-indp que)
                                                (P+v-fin estão)
                                                (SC+icl 
                                                  (P+v-pcp previstas)
                                                  (ADVL+pp 
                                                    (H+prp em)
                                                    (P<+np 
                                                      (>N+pron-det todo_o)
                                                      (H+n concelho)))))))))))))
               (.))
      
#854 CP161-6 A Câmara Municipal aponta os complicados processos burocráticos como os grandes entraves para que tudo se concretize uma vez que a maioria dos apoios financeiros já estará garantida.
(STA+fcl (SUBJ+np (>N+art A)
