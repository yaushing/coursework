                                     (>N+art o)
                                     (H+prop Governo)
                                     (N<+pp 
                                       (H+prp de)
                                       (P<+np 
                                         (>N+art o)
                                         (H+prop Bloco_Central))))
                                   (,)
                                   (ADVL+advp 
                                     (H+adv através)
                                     (A<+pp 
                                       (H+prp de)
                                       (P<+np 
                                         (>N+art o)
