                                         (CO+conj-c e)
                                         (CJT+np 
                                           (>N+num 15)
                                           (H+n km)))
                                       (N<+pp 
                                         (H+prp a)
                                         (P<+np 
                                           (H+n oeste)
                                           (N<+pp 
                                             (H+prp de)
                                             (P<+prop Grozni)))))))
                                 (}))))
           (.))
  
