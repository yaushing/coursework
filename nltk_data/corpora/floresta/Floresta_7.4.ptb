           (ACC+np (>N+art as)
                   (H+n localidades)
                   (N<+pp (H+prp de)
                          (P<+np (H+cu (CJT+prop Samachki)
                                       (CO+conj-c e)
                                       (CJT+prop Zakan-Iurt))
                                 ({)
                                 (N<PRED+icl 
                                   (P+v-pcp situadas)
                                   (ADVS+pp 
                                     (>A+adv respectivamente)
                                     (H+prp a)
