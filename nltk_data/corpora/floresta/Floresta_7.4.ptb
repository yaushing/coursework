                    (H+prop Banco_de_Portugal))
           (PAUX+v-fin voltou)
           (AUX<+cu (CJT+icl (PMV+vp- (PRT-AUX<+prp a))
                             (ADVL+adv não)
                             (-PMV+vp (MV+v-inf anunciar))
                             (ACC+np (>N+art as)
