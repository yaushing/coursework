                                             (,)
                                             («)
                                             (APP+prop Pravda)
                                             (,)
                                             (N<PRED+fcl 
                                               (ADVL+pp 
                                                 (H+prp segundo)
                                                 (P<+pron-indp o_qual))
                                               (SUBJ+np 
                                                 (>N+art os)
