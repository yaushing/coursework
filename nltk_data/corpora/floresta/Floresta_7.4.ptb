                                   (SUBJ+pron-indp que)
                                   (P+v-fin responderam)
                                   (PIV+pp 
                                     (H+prp a)
                                     (P<+np 
                                       (>N+art o)
                                       (H+n ataque)))
                                   (ADVL+icl 
                                     (P+v-ger abrindo)
                                     (ACC+n fogo)
                                     (ADVL+pp 
                                       (H+prp sobre)
                                       (P<+np 
                                         («)
                                         (H+n concentrações)
                                         (N<+pp 
                                           (H+prp de)
                                           (P<+np 
                                             (H+n combatentes)
                                             (»)
                                             (N<+adj tchetchenos)))
                                         (,)
                                         (N<PRED+pp 
                                           (H+prp segundo)
                                           (P<+np 
                                             (>N+art o)
                                             (H+n termo)
                                             (N<+icl 
                                               (P+v-pcp utilizado)
                                               (PASS+pp 
                                                 (H+prp por)
                                                 (P<+np 
                                                   (>N+art o)
                                                   (H+n centro)
                                                   (N<+pp 
                                                     (H+prp de)
                                                     (P<+np 
                                                       (H+n imprensa)
                                                       (N<+icl 
                                                         (P+v-pcp instalado)
                                                         (ADVS+pp 
                                                           (H+prp em)
                                                           (P<+np 
                                                             (H+prop Mosdok)
                                                             ({)
                                                             (N<PRED+np 
                                                               (H+prop Ossétia)
                                                               (N<+pp 
                                                                 (H+prp de)
                                                                 (P<+np 
                                                                   (>N+art o)
                                                                   (H+n Norte))))
                                                             (})
                                                             (,)
                                                             (N<PRED+np 
                                                               (H+n quartel-general)
                                                               (N<+pp 
                                                                 (H+prp de)
                                                                 (P<+np 
