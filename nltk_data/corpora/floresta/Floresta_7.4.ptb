          (N<+fcl (SUBJ+pron-indp que)
                  (P+v-fin obrigam)
                  (ACC+np (>N+art os)
                          (H+n grupos))
                  (PIV+pp (H+prp a)
                          (P<+icl (P+v-inf montar)
                                  (ACC+n peças)
                                  (ADVL+pp 
                                    (H+prp a)
                                    (P<+v-inf correr))
                                  (ADVL+pp 
                                    (>P+adv só)
                                    (H+prp para)
                                    (P<+icl 
                                      (ADVL+adv não)
                                      (P+vp 
                                        (AUX+v-inf serem)
                                        (MV+v-pcp penalizados))
                                      (ADVL+adv monetariamente)))))
                  (--)
                  («)
                  (S<+fcl (SUBJ+pron-indp o_que)
                          (ADVL+adv não)
                          (P+v-fin é)
                          (SC+adj saudável)
                          (ADVL+cu (CJT+pp 
                                     (H+prp para)
                                     (P<+pron-indp ninguém))
                                   (,)
                                   (CJT+pp 
                                     (>P+advp 
                                       (>A+adv muito)
                                       (H+adv menos))
                                     (H+prp para)
                                     (P<+np 
                                       (>N+art o)
                                       (H+prop Gil_Vicente)))))
                  (»))
          (.))
  
