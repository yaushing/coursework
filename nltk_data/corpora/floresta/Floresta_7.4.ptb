#1 CP1-1 Um revivalismo refrescante
(UTT+np (>N+art Um)
        (H+n revivalismo)
        (N<+adj refrescante))

#2 CP1-2 O 7 e Meio é um ex-libris da noite algarvia.
(STA+fcl (SUBJ+np (>N+art O)
                  (H+prop 7_e_Meio))
         (P+v-fin é)
         (SC+np (>N+art um)
                (H+n ex-libris)
                (N<+pp (H+prp de)
                       (P<+np (>N+art a)
                              (H+n noite)
                              (N<+adj algarvia))))
         (.))

#3 CP1-3 É uma das mais antigas discotecas do Algarve, situada em Albufeira, que continua a manter os traços decorativos e as clientelas de sempre.
(STA+fcl (P+v-fin É)
         (SC+np (H+num uma)
                (A<+pp (H+prp de)
                       (P<+np (>N+art as)
                              (>N+ap (>A+adv mais)
                                     (H+adj antigas))
                              (H+n discotecas)
                              (N<+pp (H+prp de)
                                     (P<+np 
                                       (>N+art o)
                                       (H+prop Algarve)))))
                (,)
                (A<+icl (P+v-pcp situada)
                        (ADVL+pp (H+prp em)
                                 (P<+prop Albufeira)))
                (,)
                (A<+fcl (SUBJ+pron-indp que)
                        (P+vp (AUX+v-fin continua)
                              (PRT-AUX<+prp a)
                              (MV+v-inf manter))
                        (ACC+cu (CJT+np (>N+art os)
                                        (H+n traços)
                                        (N<+adj decorativos))
                                (CO+conj-c e)
                                (CJT+np (>N+art as)
                                        (H+n clientelas)
                                        (N<+pp 
                                          (H+prp de)
                                          (P<+adv sempre))))))
         (.))

#4 CP1-4 É um pouco a versão de uma espécie de «outro lado» da noite, a meio caminho entre os devaneios de uma fauna periférica, seja de Lisboa, Londres, Dublin ou Faro e Portimão, e a postura circunspecta dos fiéis da casa, que dela esperam a música «geracionista» dos 60 ou dos 70.
(STA+fcl (P+v-fin É)
         (ADVL+adv um_pouco)
         (SC+np (>N+art a)
                (H+n versão)
                (N<+pp (H+prp de)
                       (P<+np (>N+art uma)
                              (H+n espécie)
                              (N<+pp (H+prp de)
                                     («)
                                     (P<+np 
                                       (>N+pron-det outro)
                                       (H+n lado)
                                       (N<+pp 
                                         (H+prp de)
                                         (P<+np 
                                           (>N+art a)
                                           (H+n noite))))
                                     (»")))))
         (,)
         (ADVL+pp (H+prp a)
                  (P<+np (>N+adj meio)
                         (H+n caminho)
                         (N<+pp (H+prp entre)
                                (P<+np (>N+art os)
                                       (H+n devaneios)
                                       (N<+pp 
                                         (H+prp de)
                                         (P<+cu 
                                           (CJT+np 
                                             (>N+art uma)
                                             (H+n fauna)
                                             (N<+adj periférica)
                                             (,)
                                             (N<PRED+fcl 
                                               (P+v-fin seja)
                                               (SC+pp 
                                                 (H+prp de)
                                                 (P<+cu 
                                                   (CJT+prop Lisboa)
                                                   (,)
                                                   (CJT+prop Londres)
                                                   (,)
                                                   (CJT+prop Dublin)
                                                   (CO+conj-c ou)
                                                   (CJT+n Faro)
                                                   (CO+conj-c e)
                                                   (CJT+prop Portimão)))))
                                           (,)
                                           (CO+conj-c e)
                                           (CJT+np 
                                             (>N+art a)
                                             (H+n postura)
                                             (N<+adj circunspecta)
                                             (N<+pp 
                                               (H+prp de)
                                               (P<+np 
                                                 (>N+art os)
                                                 (H+n fiéis)
                                                 (N<+pp 
                                                   (H+prp de)
                                                   (P<+np 
                                                     (>N+art a)
                                                     (H+n casa)))
                                                 (,)
                                                 (N<PRED+fcl 
                                                   (SUBJ+pron-indp que)
                                                   (PIV+pp 
                                                     (H+prp de)
                                                     (P<+pron-pers ela))
                                                   (P+v-fin esperam)
                                                   (ACC+np 
                                                     (>N+art a)
                                                     (H+n música)
                                                     («)
                                                     (N<+n geracionista)
                                                     (»")
                                                     (N<+cu 
                                                       (CJT+pp 
                                                         (H+prp de)
                                                         (P<+ap 
                                                           (>A+art os)
                                                           (H+num 60)))
                                                       (CO+conj-c ou)
                                                       (CJT+pp 
                                                         (H+prp de)
                                                         (P<+ap 
                                                           (>A+art os)
                                                           (H+num 70)))))))))))))))
         (.))

#5 CP1-5 Não deixa de ser, nos tempos que correm, um certo «very typical» algarvio, cabeça de cartaz para os que querem fugir a algumas movimentações nocturnas já a caminho da ritualização de massas, do género «vamos todos ao Calypso e encontramo-nos na Locomia».
(STA+fcl (ADVL+adv Não)
         (P+vp (AUX+v-fin deixa)
               (PRT-AUX<+prp de)
               (MV+v-inf ser))
         (,)
         (ADVL+pp (H+prp em)
                  (P<+np (>N+art os)
                         (H+n tempos)
                         (N<+fcl (SUBJ+pron-indp que)
                                 (P+v-fin correm))))
         (,)
         (SC+np (>N+art um)
                (>N+pron-det certo)
                («)
                (H+n very_typical)
                (N<+adj algarvio)
                (»")
                (,)
                (N<PRED+np (H+n cabeça)
                           (N<+pp (H+prp de)
                                  (P<+n cartaz))
                           (N<+pp (H+prp para)
                                  (P<+np 
                                    (H+pron-det os)
                                    (N<+fcl 
                                      (SUBJ+pron-indp que)
                                      (P+v-fin querem)
                                      (ACC+icl 
                                        (P+v-inf fugir)
                                        (ADVS+pp 
                                          (H+prp a)
                                          (P<+np 
                                            (>N+pron-det algumas)
                                            (H+n movimentações)
                                            (N<+adj nocturnas)
                                            (N<+pp 
                                              (>A+adv já)
                                              (H+prp a)
                                              (P<+np 
                                                (H+n caminho)
                                                (N<+pp 
                                                  (H+prp de)
                                                  (P<+np 
                                                    (>N+art a)
                                                    (H+n ritualização)
                                                    (N<+pp 
                                                      (H+prp de)
                                                      (P<+n massas))))))
                                            (,)
                                            (N<PRED+pp 
                                              (H+prp de)
                                              (P<+np 
                                                (>N+art o)
                                                (H+n género)
                                                («)
                                                (N<PRED+cu 
                                                  (CJT+fcl 
                                                    (P+v-fin vamos)
                                                    (SUBJ+pron-det todos)
                                                    (ADVS+pp 
                                                      (H+prp a)
                                                      (P<+np 
                                                        (>N+art o)
                                                        (H+prop Calypso))))
                                                  (CO+conj-c e)
                                                  (CJT+fcl 
                                                    (P+v-fin encontramos-)
                                                    (ACC+pron-pers nos)
                                                    (ADVL+pp 
                                                      (H+prp em)
                                                      (P<+np 
                                                        (>N+art a)
                                                        (H+prop Locomia)))))
                                                (»")))))))))))
         (.))

#6 CP2-1 E assim, aos 2,5 milhões que o Ministério do Planeamento e Administração do Território já gasta no pagamento do pessoal afecto a estes organismos, vêm juntar-se os montantes das obras propriamente ditas, que os municípios, já com projectos na mão, vêm reivindicar junto do Executivo, como salienta aquele membro do Governo.
(STA+fcl (CO+conj-c E)
         (ADVL+adv assim)
         (,)
         (ADVL+pp (H+prp a)
                  (P<+np (>N+art os)
                         (>N+num 2,5)
                         (H+n milhões)
                         (N<+fcl (ACC+pron-indp que)
                                 (SUBJ+np 
                                   (>N+art o)
                                   (H+prop Ministério_do_Planeamento_e_Administração_do_Território))
                                 (ADVL+adv já)
                                 (P+v-fin gasta)
                                 (PIV+pp 
                                   (H+prp em)
                                   (P<+np 
                                     (>N+art o)
                                     (H+n pagamento)
                                     (N<+pp 
                                       (H+prp de)
                                       (P<+np 
                                         (>N+art o)
                                         (H+n pessoal)
                                         (N<+icl 
                                           (P+v-pcp afecto)
                                           (PIV+pp 
                                             (H+prp a)
                                             (P<+np 
                                               (>N+pron-det estes)
                                               (H+n organismos)))))))))))
         (,)
         (P+v-fin vêm)
         (ADVL+icl (P+v-inf juntar-)
                   (ACC+pron-pers se)
                   (SUBJ+np (>N+art os)
                            (H+n montantes)
                            (N<+pp (H+prp de)
                                   (P<+np 
                                     (>N+art as)
                                     (H+n obras)
                                     (N<+ap 
                                       (>A+adv propriamente)
                                       (H+adj ditas))))
                            (,)
                            (N<+fcl (ACC+pron-indp que)
                                    (SUBJ+np 
                                      (>N+art os)
                                      (H+n municípios)
                                      (,)
                                      (N<PRED+pp 
                                        (>A+adv já)
                                        (H+prp com)
                                        (P<+np 
                                          (H+n projectos)
                                          (N<+pp 
                                            (H+prp em)
                                            (P<+np 
                                              (>N+art a)
                                              (H+n mão)))))
                                      (,))
                                    (P+vp 
                                      (AUX+v-fin vêm)
                                      (MV+v-inf reivindicar))
                                    (ADVL+advp 
                                      (H+adv junto)
                                      (A<+pp 
                                        (H+prp de)
                                        (P<+np 
                                          (>N+art o)
                                          (H+n Executivo)))))))
         (,)
         (ADVL+pp (H+prp como)
                  (P<+fcl (P+v-fin salienta)
                          (SUBJ+np (>N+pron-det aquele)
                                   (H+n membro)
                                   (N<+pp 
                                     (H+prp de)
                                     (P<+np 
                                       (>N+art o)
                                       (H+prop Governo))))))
         (.))

#7 CP2-2 E o dinheiro «não falta só às câmaras», lembra o secretário de Estado, que considera que a solução para as autarquias é «especializarem-se em fundos comunitários».
(STA+fcl (ACC+fcl (CO+conj-c E)
                  (SUBJ+np (>N+art o)
                           (H+n dinheiro))
                  («)
                  (ADVL+adv não)
                  (P+v-fin falta)
                  (PIV+pp (>A+adv só)
                          (H+prp a)
                          (P<+np (>N+art as)
                                 (H+n câmaras)))
                  (»"))
         (,)
         (P+v-fin lembra)
         (SUBJ+np (>N+art o)
                  (H+n secretário_de_Estado)
                  (,)
                  (N<PRED+fcl (SUBJ+pron-indp que)
                              (P+v-fin considera)
                              (ACC+fcl (SUB+conj-s que)
                                       (SUBJ+np 
                                         (>N+art a)
                                         (H+n solução)
                                         (N<+pp 
                                           (H+prp para)
                                           (P<+np 
                                             (>N+art as)
                                             (H+n autarquias))))
                                       (P+v-fin é)
                                       («)
                                       (SC+icl 
                                         (P+v-inf especializarem-)
                                         (ACC+pron-pers se)
                                         (ADVL+pp 
                                           (H+prp em)
                                           (P<+np 
                                             (H+n fundos)
                                             (N<+adj comunitários))))
                                       (»"))))
         (.))

#8 CP2-3 Mas como, se muitas não dispõem, nos seus quadros, dos técnicos necessários?
(QUE+fcl (CO+conj-c Mas)
         (ADVL+adv como)
         (,)
         (ADVL+fcl (SUB+conj-s se)
                   (SUBJ+pron-det muitas)
                   (ADVL+adv não)
                   (P+v-fin dispõem)
                   (,)
                   (ADVL+pp (H+prp em)
                            (P<+np (>N+art os)
                                   (>N+pron-det seus)
                                   (H+n quadros)))
                   (,)
                   (PIV+pp (H+prp de)
                           (P<+np (>N+art os)
                                  (H+n técnicos)
                                  (N<+adj necessários))))
         (?))

#9 CP2-4 «Encomendem-nos a projectistas de fora» porque, se as obras vierem a ser financiadas, eles até saem de graça, já que, nesse caso, «os fundos comunitários pagam os projectos, o mesmo não acontecendo quando eles são feitos pelos GAT», dado serem organismos do Estado.
(STA+fcl («)
         (P+v-fin Encomendem-)
         (ACC+pron-pers nos)
         (PIV+pp (H+prp a)
                 (P<+np (H+n projectistas)
                        (N<+pp de_fora)))
         (»")
         (ADVL+fcl (SUB+conj-s porque)
                   (,)
                   (ADVL+fcl (SUB+conj-s se)
                             (SUBJ+np (>N+art as)
                                      (H+n obras))
                             (P+vp (AUX+v-fin vierem)
                                   (PRT-AUX<+prp a)
                                   (AUX+v-inf ser)
                                   (MV+v-pcp financiadas)))
                   (,)
                   (SUBJ+pron-pers eles)
                   (ADVL+adv até)
                   (P+v-fin saem)
                   (ADVS+pp de_graça)
                   (,)
                   (ADVL+fcl (SUB+conj-s já_que)
                             (,)
                             (ADVL+pp (H+prp em)
                                      (P<+np 
                                        (>N+pron-det esse)
                                        (H+n caso)))
                             (,)
                             («)
                             (SUBJ+np (>N+art os)
                                      (H+n fundos)
                                      (N<+adj comunitários))
                             (P+v-fin pagam)
                             (ACC+np (>N+art os)
                                     (H+n projectos))
                             (,))
                   (ADVL+icl (SUBJ+np (>N+art o)
                                      (H+pron-det mesmo))
                             (ADVL+adv não)
                             (P+v-ger acontecendo)
                             (ADVL+fcl (ADVL+adv quando)
                                       (SUBJ+pron-pers eles)
                                       (P+vp 
                                         (AUX+v-fin são)
                                         (MV+v-pcp feitos))
                                       (PASS+pp 
                                         (H+prp por)
                                         (P<+np 
                                           (>N+art os)
                                           (H+prop GAT)))
                                       (»")
                                       (,)
                                       (ADVL+icl 
                                         (P+v-pcp dado)
                                         (ACC+icl 
                                           (P+v-inf serem)
                                           (SC+np 
                                             (H+n organismos)
                                             (N<+pp 
                                               (H+prp de)
                                               (P<+np 
                                                 (>N+art o)
                                                 (H+n Estado)))))))))
         (.))

#10 CP2-5 Essa poderá vir a ser uma hipótese, até porque, no terreno, a capacidade dos GAT está cada vez mais enfraquecida.
(STA+fcl (SUBJ+pron-det Essa)
         (P+vp (AUX+v-fin poderá)
               (AUX+v-inf vir)
               (PRT-AUX<+prp a)
               (MV+v-inf ser))
         (SC+np (>N+art uma)
                (H+n hipótese))
         (,)
         (ADVL+fcl (>S+adv até)
                   (SUB+conj-s porque)
                   (,)
                   (ADVL+pp (H+prp em)
                            (P<+np (>N+art o)
                                   (H+n terreno)))
                   (,)
                   (SUBJ+np (>N+art a)
                            (H+n capacidade)
                            (N<+pp (H+prp de)
                                   (P<+np 
                                     (>N+art os)
                                     (H+prop GAT))))
                   (P+v-fin está)
                   (SC+ap (>A+adv cada_vez_mais)
                          (H+v-pcp enfraquecida)))
         (.))

#11 CP2-6 Alguns até já desapareceram, como o de Castro Verde, e outros têm vindo a perder quadros.
(STA+cu (CJT+fcl (SUBJ+np- (H+pron-det Alguns))
                 (ADVL+adv até)
                 (ADVL+adv já)
                 (P+v-fin desapareceram)
                 (,)
                 (-SUBJ+np (N<+acl (COM+adv como)
                                   (SUBJ+np 
                                     (H+pron-det o)
                                     (N<+pp 
                                       (H+prp de)
                                       (P<+prop Castro_Verde))))))
        (,)
        (CO+conj-c e)
        (CJT+fcl (SUBJ+pron-det outros)
                 (P+vp (AUX+v-fin têm)
                       (AUX+v-pcp vindo)
                       (PRT-AUX<+prp a)
                       (MV+v-inf perder))
                 (ACC+n quadros))
        (.))

#12 CP2-7 Um arquitecto para 800 Km2
(UTT+np (>N+art Um)
        (H+n arquitecto)
        (N<+pp (H+prp para)
               (P<+np (>N+num 800)
                      (H+n Km2))))

#13 CP3-1 «Orelhas» para os computadores
(UTT+np («)
        (H+n Orelhas)
        (»")
        (N<+pp (H+prp para)
               (P<+np (>N+art os)
                      (H+n computadores))))

#14 CP3-2 O primeiro fabricante mundial de «ratos» para computador, a empresa suíça Logitech, apresentou esta semana numa feira especializada que teve lugar em Basileia (Suíça) um equipamento periférico denominado «Audioman» que permitirá dotar os computadores de «orelhas».
(STA+fcl (SUBJ+np (>N+art O)
                  (>N+adj primeiro)
                  (H+n fabricante)
                  (N<+adj mundial)
                  (N<+pp (H+prp de)
                         (P<+np («)
                                (H+n ratos)
                                (»")
                                (N<+pp (H+prp para)
                                       (P<+n computador))))
                  (,)
                  (APP+np (>N+art a)
                          (H+n empresa)
                          (N<+adj suíça)
                          (N<+prop Logitech))
                  (,))
         (P+v-fin apresentou)
         (ADVL+np (>N+pron-det esta)
                  (H+n semana))
         (ADVL+pp (H+prp em)
                  (P<+np (>N+art uma)
                         (H+n feira)
                         (N<+v-pcp especializada)
                         (N<+fcl (SUBJ+pron-indp que)
                                 (P+v-fin teve)
                                 (ACC+n lugar)
                                 (ADVL+pp 
                                   (H+prp em)
                                   (P<+prop Basileia)
                                   ({)
                                   (N<PRED+prop Suíça)
                                   (})))))
         (ACC+np (>N+art um)
                 (H+n equipamento)
                 (N<+adj periférico)
                 (N<+icl (P+v-pcp denominado)
                         (SC+np («)
                                (H+prop Audioman)
                                (»")
                                (N<+fcl (SUBJ+pron-indp que)
                                        (P+v-fin permitirá)
                                        (ACC+icl 
                                          (P+v-inf dotar)
                                          (ACC+np 
                                            (>N+art os)
                                            (H+n computadores))
                                          (PIV+pp 
                                            (H+prp de)
                                            («)
                                            (P<+n orelhas)
                                            (»")))))))
         (.))

#15 CP3-3 Segundo a empresa, o aparelho permite que o aparelho grave e transcreva a voz humana.
(STA+fcl (ADVL+pp (H+prp Segundo)
                  (P<+np (>N+art a)
                         (H+n empresa)))
         (,)
         (SUBJ+np (>N+art o)
                  (H+n aparelho))
         (P+v-fin permite)
         (ACC+fcl (SUB+conj-s que)
                  (SUBJ+np (>N+art o)
                           (H+n aparelho))
                  (P+cu (CJT+v-fin grave)
                        (CO+conj-c e)
                        (CJT+v-fin transcreva))
                  (ACC+np (>N+art a)
                          (H+n voz)
                          (N<+adj humana)))
         (.))

#16 CP3-4 «Estamos a dotar os computadores de um novo sentido» disse Steve d'Averio, director de marketing para a Europa da Logitech.
(STA+fcl («)
         (ACC+fcl (P+vp (AUX+v-fin Estamos)
                        (PRT-AUX<+prp a)
                        (MV+v-inf dotar))
                  (ACC+np (>N+art os)
                          (H+n computadores))
                  (PIV+pp (H+prp de)
                          (P<+np (>N+art um)
                                 (>N+adj novo)
                                 (H+n sentido))))
         (»")
         (P+v-fin disse)
         (SUBJ+np (H+prop Steve_d’_Averio)
                  (,)
                  (N<PRED+np (H+n director)
                             (N<+pp (H+prp de)
                                    (P<+np 
                                      (H+n marketing)
                                      (N<+pp 
                                        (H+prp para)
                                        (P<+np 
                                          (>N+art a)
                                          (H+prop Europa)))))
                             (N<+pp (H+prp de)
                                    (P<+np 
                                      (>N+art a)
                                      (H+prop Logitech)))))
         (.))

#17 CP3-5 O Audioman foi desenvolvido na Suíça em apenas sete meses e compõe-se de um microfone e de um altifalante que se podem acoplar facilmente a um computador, devendo ser comercializado ao preço de 290 francos suíços (28 contos).
(STA+fcl (SUBJ+np (>N+art O)
                  (H+prop Audioman))
         (?+cu (CJT+? (P+vp (AUX+v-fin foi)
                            (MV+v-pcp desenvolvido))
                      (ADVL+pp (H+prp em)
                               (P<+np (>N+art a)
                                      (H+prop Suíça)))
                      (ADVL+pp (H+prp em)
                               (P<+np (>N+ap 
                                        (>A+adv apenas)
                                        (H+num sete))
                                      (H+n meses))))
               (CO+conj-c e)
               (CJT+? (P+v-fin compõe-)
                      (ACC+pron-pers se)
                      (ADVL+cu (CJT+pp (H+prp de)
                                       (P<+np 
                                         (>N+art um)
                                         (H+n microfone)))
                               (CO+conj-c e)
                               (CJT+pp (H+prp de)
                                       (P<+np 
                                         (>N+art um)
                                         (H+n altifalante)
                                         (N<+fcl 
                                           (SUBJ+pron-indp que)
                                           (ACC+pron-pers se)
                                           (P+vp 
                                             (AUX+v-fin podem)
                                             (MV+v-inf acoplar))
                                           (ADVL+adv facilmente)
                                           (PIV+pp 
                                             (H+prp a)
                                             (P<+np 
                                               (>N+art um)
                                               (H+n computador)))))))))
         (,)
         (ADVL+icl (P+vp (AUX+v-ger devendo)
                         (AUX+v-inf ser)
