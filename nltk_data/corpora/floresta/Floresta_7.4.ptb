           (,)
           (SUBJ+np (>N+art uma)
                    (H+n editora)
                    (N<+np (>N+art uma)
                           (H+adj italiana)))
           (P+v-fin descobriu-)
           (ACC+pron-pers o)
           (.))
  
#529 CP101-3 Maria Teresa Pazzolo traduziu-o, prefaciou-o e ilustrou-o, com fotografias de sua autoria.
(STA+fcl (SUBJ+prop Maria_Teresa_Pazzolo)
           (?+cu (CJT+? (P+v-fin traduziu-)
                        (ACC+pron-pers o))
                 (,)
                 (CJT+? (P+v-fin prefaciou-)
                        (ACC+pron-pers o))
                 (CO+conj-c e)
                 (CJT+? (P+v-fin ilustrou-)
                        (ACC+pron-pers o)
                        (,)
                        (ADVL+pp (H+prp com)
                                 (P<+np (H+n fotografias)
                                        (N<+pp 
                                          (H+prp de)
                                          (P<+np 
                                            (>N+pron-det sua)
                                            (H+n autoria)))))))
           (.))
  
#530 CP101-4 A AIE-Guaraldi, da Reppublica di San Marino chancelou este livro que se deixa inquietar com o desaparecimento da Ilha de Moçambique.
(STA+fcl (SUBJ+np (>N+art A)
                    (H+prop AIE-Guaraldi)
                    (,)
                    (N<PRED+pp (H+prp de)
                               (P<+np (>N+art a)
                                      (H+prop Reppublica_di_San_Marino))))
           (P+v-fin chancelou)
           (ACC+np (>N+pron-det este)
                   (H+n livro)
                   (N<+fcl (SUBJ+pron-indp que)
                           (ACC+pron-pers se)
                           (P+v-fin deixa)
                           (ACC+icl (P+v-inf inquietar)
                                    (ADVL+pp 
                                      (H+prp com)
                                      (P<+np 
                                        (>N+art o)
                                        (H+n desaparecimento)
                                        (N<+pp 
                                          (H+prp de)
                                          (P<+np 
                                            (>N+art a)
                                            (H+prop Ilha_de_Moçambique))))))))
           (.))
  
#531 CP101-5 Em Portugal, esta novela não foi ainda editada.
(STA+fcl (ADVL+pp (H+prp Em)
                    (P<+prop Portugal))
           (,)
           (SUBJ+np (>N+pron-det esta)
                    (H+n novela))
           (ADVL+adv não)
           (P+vp- (AUX+v-fin foi))
           (ADVL+adv ainda)
           (-P+vp (MV+v-pcp editada))
           (.))
  
#532 CP101-6 Com a sua publicação em Itália, talvez «O Barco Encalhado» desenterre as amarras e aporte no Tejo.
(STA+fcl (ADVL+pp (H+prp Com)
                    (P<+np (>N+art a)
                           (>N+pron-det sua)
                           (H+n publicação)
                           (N<+pp (H+prp em)
                                  (P<+prop Itália))))
           (,)
           (ADVL+adv talvez)
           («)
           (SUBJ+prop O_Barco_Encalhado)
           (»)
           (?+cu (CJT+? (P+v-fin desenterre)
                        (ACC+np (>N+art as)
                                (H+n amarras)))
                 (CO+conj-c e)
                 (CJT+? (P+v-fin aporte)
                        (ADVS+pp (H+prp em)
                                 (P<+np (>N+art o)
                                        (H+prop Tejo)))))
           (.))
  
#533 CP101-7 O que seria importante pois, de alguma forma, este livro combate a visão preconceituosa e lacunar que, ao longo dos tempos, à Ilha de Moçambique tem sido consagrada.
(STA+fcl (SUBJ+pron-indp O_que)
           (P+v-fin seria)
           (SC+adj importante)
           (ADVL+fcl (SUB+conj-s pois)
                     (,)
                     (ADVL+pp (H+prp de)
                              (P<+np (>N+pron-det alguma)
                                     (H+n forma)))
                     (,)
                     (SUBJ+np (>N+pron-det este)
                              (H+n livro))
                     (P+v-fin combate)
                     (ACC+np (>N+art a)
                             (H+n visão)
                             (N<+cu (CJT+adj preconceituosa)
                                    (CO+conj-c e)
                                    (CJT+adj lacunar))
                             (N<+fcl (SUBJ+pron-indp que)
                                     (,)
                                     (ADVL+pp 
                                       (H+prp ao_longo_de)
                                       (P<+np 
                                         (>N+art os)
                                         (H+n tempos)))
                                     (,)
                                     (PIV+pp 
                                       (H+prp a)
                                       (P<+np 
                                         (>N+art a)
                                         (H+prop Ilha_de_Moçambique)))
                                     (P+vp 
                                       (AUX+v-fin tem)
                                       (AUX+v-pcp sido)
                                       (MV+v-pcp consagrada)))))
           (.))
  
#534 CP102-1 Ministros europeu aprovam lei de assistência à família
(STA+fcl (SUBJ+np (H+n Ministros)
                    (N<+adj europeu))
           (P+v-fin aprovam)
           (ACC+np (H+n lei)
                   (N<+pp (H+prp de)
                          (P<+np (H+n assistência)
                                 (N<+pp (H+prp a)
                                        (P<+np 
                                          (>N+art a)
                                          (H+n família)))))))
  
#535 CP102-2 Os ministros europeus do Trabalho e dos Assuntos Sociais aprovaram ontem no Luxemburgo leis comunitárias instituindo uma licença mínima de três meses para assistência à família e a aplicação de regras do país de acolhimento para os trabalhadores deslocados no estrangeiro, anunciou o ministro alemão Norbert Blum.
(STA+fcl (ACC+fcl (SUBJ+np (>N+art Os)
                             (H+n ministros)
                             (N<+adj europeus)
                             (N<+cu (CJT+pp 
                                      (H+prp de)
                                      (P<+np 
                                        (>N+art o)
                                        (H+prop Trabalho)))
                                    (CO+conj-c e)
                                    (CJT+pp 
                                      (H+prp de)
                                      (P<+np 
                                        (>N+art os)
                                        (H+prop Assuntos_Sociais)))))
                    (P+v-fin aprovaram)
                    (ADVL+adv ontem)
                    (ADVL+pp (H+prp em)
                             (P<+np (>N+art o)
                                    (H+prop Luxemburgo)))
                    (ACC+cu (CJT+np (H+n leis)
                                    (N<+adj comunitárias)
                                    (N<+icl 
                                      (P+v-ger instituindo)
                                      (ACC+np 
                                        (>N+art uma)
                                        (H+n licença)
                                        (N<+adj mínima)
                                        (N<+pp 
                                          (H+prp de)
                                          (P<+np 
                                            (>N+num três)
                                            (H+n meses)
                                            (N<+pp 
                                              (H+prp para)
                                              (P<+np 
                                                (H+n assistência)
                                                (N<+pp 
                                                  (H+prp a)
                                                  (P<+np 
                                                    (>N+art a)
                                                    (H+n família))))))))))
                            (CO+conj-c e)
                            (CJT+np (>N+art a)
                                    (H+n aplicação)
                                    (N<+pp 
                                      (H+prp de)
                                      (P<+np 
                                        (H+n regras)
                                        (N<+pp 
                                          (H+prp de)
                                          (P<+np 
                                            (>N+art o)
                                            (H+n país)
                                            (N<+pp 
                                              (H+prp de)
                                              (P<+n acolhimento))))))
                                    (N<+pp 
                                      (H+prp para)
                                      (P<+np 
                                        (>N+art os)
                                        (H+n trabalhadores)
                                        (N<+icl 
                                          (P+v-pcp deslocados)
                                          (ADVL+pp 
                                            (H+prp em)
                                            (P<+np 
                                              (>N+art o)
                                              (H+n estrangeiro)))))))))
           (,)
           (P+v-fin anunciou)
           (SUBJ+np (>N+art o)
                    (H+n ministro)
                    (N<+adj alemão)
                    (N<+prop Norbert_Blum))
           (.))
  
#536 CP102-3 Estes dois projectos tinham sido objecto de um acordo político durante a última reunião dos Quinze, a 29 de Março em Bruxelas, mas faltava-lhes a adopção formal.
(STA+cu (CJT+fcl (SUBJ+np (>N+pron-det Estes)
                            (>N+num dois)
                            (H+n projectos))
                   (P+vp (AUX+v-fin tinham)
                         (MV+v-pcp sido))
                   (SC+np (H+n objecto)
                          (N<+pp (H+prp de)
                                 (P<+np (>N+art um)
                                        (H+n acordo)
                                        (N<+adj político)
                                        (N<+pp 
                                          (H+prp durante)
                                          (P<+np 
                                            (>N+art a)
                                            (>N+adj última)
                                            (H+n reunião)
                                            (N<+pp 
                                              (H+prp de)
                                              (P<+np 
                                                (>N+art os)
                                                (H+num Quinze)))
                                            (,)
                                            (N<PRED+pp 
                                              (H+prp a)
                                              (P<+ap 
                                                (H+num 29)
                                                (A<+pp 
                                                  (H+prp de)
                                                  (P<+n Março))))
                                            (N<PRED+pp 
                                              (H+prp em)
                                              (P<+prop Bruxelas))
                                            (,)))))))
          (CO+conj-c mas)
          (CJT+fcl (P+v-fin faltava-)
                   (DAT+pron-pers lhes)
                   (SUBJ+np (>N+art a)
                            (H+n adopção)
                            (N<+adj formal)))
          (.))
  
#537 CP103-1 O fogo consumiu inúmeros fardos de bacalhau, dois dos três túneis de secagem artificial, alguns compressores, duas carrinhas utilizadas no transporte dos trabalhadores da fábrica e um carro de marca «Triumph», propriedade do comendador.
(STA+fcl (SUBJ+np (>N+art O)
                    (H+n fogo))
           (P+v-fin consumiu)
           (ACC+cu (CJT+np (>N+adj inúmeros)
                           (H+n fardos)
                           (N<+pp (H+prp de)
                                  (P<+n bacalhau)))
                   (,)
                   (CJT+ap (H+num dois)
                           (A<+pp (H+prp de)
                                  (P<+np 
                                    (>N+art os)
                                    (>N+num três)
                                    (H+n túneis)
                                    (N<+pp 
                                      (H+prp de)
                                      (P<+np 
                                        (H+n secagem)
                                        (N<+adj artificial))))))
                   (,)
                   (CJT+np (>N+pron-det alguns)
                           (H+n compressores))
                   (,)
                   (CJT+np (>N+num duas)
                           (H+n carrinhas)
                           (N<+icl (P+v-pcp utilizadas)
                                   (ADVL+pp 
                                     (H+prp em)
                                     (P<+np 
                                       (>N+art o)
                                       (H+n transporte)
                                       (N<+pp 
                                         (H+prp de)
                                         (P<+np 
                                           (>N+art os)
                                           (H+n trabalhadores)
                                           (N<+pp 
                                             (H+prp de)
                                             (P<+np 
                                               (>N+art a)
                                               (H+n fábrica)))))))))
                   (CO+conj-c e)
                   (CJT+np (>N+art um)
                           (H+n carro)
                           (N<+pp de_marca)
                           («)
                           (N<+prop Triumph)
                           (»)
                           (,)
                           (N<PRED+np (H+n propriedade)
                                      (N<+pp 
                                        (H+prp de)
                                        (P<+np 
                                          (>N+art o)
                                          (H+n comendador))))))
           (.))
  
#538 CP103-2 Os armazéns e uma habitação contíguas à empresa foram também danificados pelo sinistro.
(STA+fcl (SUBJ+np (H+cu (CJT+np (>N+art Os)
