                                     (P<+fcl 
                                       (SUB+conj-s que)
                                       (SUBJ+pron-indp tudo)
                                       (ACC+pron-pers se)
                                       (P+v-fin concretize)))))
               (ADVL+fcl (SUB+conj-s uma_vez_que)
