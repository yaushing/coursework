                                   (P<+np 
                                     (>N+art o)
                                     (H+n pai)
                                     (N<+pp 
                                       (H+prp de)
                                       (P<+np 
                                         (H+prop André)
                                         (,)
                                         (APP+prop Luis_Carlos_Scafura)
                                         (,)))))
                          (SUBJ+np (>N+art os)
                                   (H+n sequestradores))
                          (P+v-fin provaram)
                          (ACC+fcl (SUB+conj-s que)
                                   (SUBJ+pron-pers ele)
                                   (P+v-fin está)
                                   (SC+adj vivo)
                                   (,)
                                   (ADVL+pp 
                                     (H+prp ao)
                                     (P<+icl 
                                       (P+v-inf responder)
                                       (ADVL+adv corretamente)
                                       (ACC+np 
                                         (>N+pron-det algumas)
                                         (H+n perguntas)
                                         (N<+pp 
                                           (H+prp sobre)
                                           (P<+np 
                                             (>N+art a)
                                             (H+n vida)
                                             (N<+pp 
                                               (H+prp de)
                                               (P<+np 
                                                 (>N+art o)
                                                 (H+n rapaz)))))))))
                          (.))
                 
