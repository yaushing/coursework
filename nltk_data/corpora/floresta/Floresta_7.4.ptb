                                            (P+v-fin entra)
                                            (ADVL+pp 
                                              (H+prp por)
                                              (P<+np 
                                                (>N+art o)
                                                (H+n mar))))))
                                 (N<PRED+np 
                                   (>N+art o)
                                   (H+n oposto)
                                   (N<+pp 
                                     (H+prp de)
                                     (P<+np 
                                       (H+n fiorde)
                                       (,)
                                       (N<PRED+fcl 
                                         (SUBJ+pron-indp que)
                                         (P+v-fin é)
                                         (SC+np 
                                           (>N+art uma)
                                           (H+n porção)
                                           (N<+pp 
                                             (H+prp de)
                                             (P<+np 
                                               (H+n mar)
                                               (N<+fcl 
                                                 (SUBJ+pron-indp que)
                                                 (P+v-fin avança)
                                                 (ADVL+pp 
                                                   (H+prp por)
                                                   (P<+np 
                                                     (>N+art o)
                                                     (H+n continente)))
                                                 (,)))))
                                         (ADVL+fcl 
                                           (ADVL+adv como)
                                           (P+v-fin acontece)
                                           (ADVL+pp 
                                             (H+prp em)
