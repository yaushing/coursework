                                    (P<+n futebol)))))
           (ADVL+adv não)
           (P+v-fin trouxe)
           (ACC+np (H+n alterações)
                   (N<+pp (H+prp a)
                          (P<+np (>N+art o)
                                 (H+n topo)
                                 (N<+pp (H+prp de)
                                        (P<+np 
                                          (>N+art a)
                                          (H+n classificação))))))
           (,)
           (ADVL+fcl (SUB+conj-s já_que)
                     (SUBJ+np (>N+art os)
                              (>N+num três)
                              (H+adj primeiros))
                     (?+cu (CJT+? (P+v-fin venceram)
                                  (ACC+np 
                                    (>N+art os)
                                    (>N+pron-det seus)
                                    (H+n jogos)))
                           (CO+conj-c e)
                           (CJT+? (P+v-fin mantêm)
                                  (ACC+np 
                                    (>N+art as)
                                    (H+n posições)
