#1934 CP369-2 Os factores que contribuíram fortemente para este movimento de correcção foram, por um lado, os receios de intervenções por parte da Reserva Federal travando a rápida apreciação da paridade dólar / iene e, por outro lado, o facto de o Bundesbank ter deixado uma vez mais as taxas de desconto e lombarda inalteradas respectivamente nos 5.75 por cento . e 6.75 por cento.
(STA+fcl (SUBJ+np (>N+art Os)
                    (H+n factores)
                    (N<+fcl (SUBJ+pron-indp que)
                            (P+v-fin contribuíram)
                            (ADVL+adv fortemente)
                            (PIV+pp (H+prp para)
                                    (P<+np 
                                      (>N+pron-det este)
                                      (H+n movimento)
                                      (N<+pp 
                                        (H+prp de)
                                        (P<+n correcção))))))
           (P+v-fin foram)
           (,)
           (SC+cu (CJT+np (>N+pp por_um_lado)
                          (,)
                          (H+np (>N+art os)
                                (H+n receios)
                                (N<+pp (H+prp de)
                                       (P<+np 
                                         (H+n intervenções)
                                         (N<+pp 
                                           (H+prp por_parte_de)
                                           (P<+np 
                                             (>N+art a)
                                             (H+prop Reserva_Federal)))))
                                (N<+icl (P+v-ger travando)
                                        (ACC+np 
                                          (>N+art a)
                                          (>N+adj rápida)
                                          (H+n apreciação)
                                          (N<+pp 
                                            (H+prp de)
                                            (P<+np 
                                              (>N+art a)
                                              (H+n paridade)
                                              (N<+cu 
                                                (CJT+n dólar)
                                                (/)
                                                (CJT+n iene))))))))
                  (CO+conj-c e)
                  (,)
                  (CJT+np (>N+pp por_outro_lado)
                          (,)
                          (H+np (>N+art o)
                                (H+n facto)
                                (N<+pp (H+prp de)
                                       (P<+icl 
                                         (SUBJ+np 
                                           (>N+art o)
                                           (H+prop Bundesbank))
                                         (P+vp 
                                           (AUX+v-inf ter)
                                           (MV+v-pcp deixado))
                                         (ADVL+adv uma_vez_mais)
                                         (ACC+np 
                                           (>N+art as)
                                           (H+n taxas)
                                           (N<+pp 
                                             (H+prp de)
                                             (P<+cu 
                                               (CJT+n desconto)
                                               (CO+conj-c e)
                                               (CJT+adj lombarda))))
                                         (OC+adj inalteradas)
                                         (ADVL+pp 
                                           (>A+adv respectivamente)
                                           (H+prp em)
                                           (P<+cu 
                                             (CJT+np 
                                               (>N+art os)
                                               (>N+num 5.75)
                                               (H+n por_cento)
                                               (.))
                                             (CO+conj-c e)
                                             (CJT+np 
                                               (>N+num 6.75)
                                               (H+n por_cento)))))))))
           (.))
  
