           (.))
  
#540 CP103-4 O bacalhau queimado estava já embalado em fardos ou disposto nos tabuleiros de secagem e pertencia a lotes de produção da empresa, sendo o peixe importado da Noruega e Dinamarca.
(STA+fcl (SUBJ+np (>N+art O)
                    (H+n bacalhau)
                    (N<+v-pcp queimado))
           (?+cu (CJT+? (P+v-fin estava)
                        (ADVL+adv já)
                        (SC+cu (CJT+icl (P+v-pcp embalado)
                                        (ADVL+pp 
                                          (H+prp em)
                                          (P<+n fardos)))
                               (CO+conj-c ou)
                               (CJT+icl (P+v-pcp disposto)
                                        (ADVL+pp 
                                          (H+prp em)
                                          (P<+np 
                                            (>N+art os)
                                            (H+n tabuleiros)
                                            (N<+pp 
                                              (H+prp de)
                                              (P<+n secagem)))))))
                 (CO+conj-c e)
                 (CJT+? (P+v-fin pertencia)
                        (PIV+pp (H+prp a)
                                (P<+np (H+n lotes)
                                       (N<+pp 
                                         (H+prp de)
                                         (P<+np 
                                           (H+n produção)
                                           (N<+pp 
                                             (H+prp de)
                                             (P<+np 
                                               (>N+art a)
                                               (H+n empresa)))))))))
           (,)
           (ADVL+icl (P+v-ger sendo)
                     (SUBJ+np (>N+art o)
                              (H+n peixe)
                              (N<+icl (P+v-pcp importado)
                                      (ADVL+pp 
                                        (H+prp de)
                                        (P<+np 
                                          (>N+art a)
                                          (H+cu 
                                            (CJT+prop Noruega)
                                            (CO+conj-c e)
                                            (CJT+prop Dinamarca)))))))
           (.))
  
