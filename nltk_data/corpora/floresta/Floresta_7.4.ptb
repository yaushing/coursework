                                  (P+v-ger cabendo)
                                  (SUBJ+np 
                                    (>N+art a)
                                    (H+n responsabilidade))
                                  (PIV+pp 
                                    (H+prp a)
                                    (P<+np 
                                      (>N+art o)
                                      (H+prop Departamento_de_Espaços_Verves)))
                                  (,)
                                  (ADVL+fcl 
                                    (SUB+conj-s já_que)
                                    (SUBJ+np 
                                      (>N+art o)
                                      (H+n projecto)
                                      (N<+icl 
                                        (P+v-pcp apresentado)
                                        (PASS+pp 
                                          (H+prp por)
                                          (P<+np 
                                            (>N+art a)
                                            (H+prop Junta_de_Freguesia)))))
                                    (P+vp 
